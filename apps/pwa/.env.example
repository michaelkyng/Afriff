# API adapter. Only "mock" exists in the frontend-only phase.
NUXT_PUBLIC_API_MODE=mock
# Simulated latency for mock API calls, in milliseconds (0 = instant).
NUXT_PUBLIC_MOCK_LATENCY=450

# Reserved for the future Supabase adapter; mock mode does not use these.
# Use the project URL and an sb_publishable_ key. Never add a secret/service-role key.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
