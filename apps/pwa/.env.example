# Which API the app talks to:
#   mock      everything runs in the browser on placeholder data (no backend)
#   firebase  Firebase Auth, Firestore and Cloud Functions, with Paystack for payment
NUXT_PUBLIC_API_MODE=mock

# Simulated latency for mock API calls, in milliseconds (0 = instant).
NUXT_PUBLIC_MOCK_LATENCY=450

# ---------------------------------------------------------------- firebase mode
# A static build bakes these in when it is generated: rebuild after changing them.
# The web config is public by design (Project settings > Your apps > Web app).
# Never put a service account, the Paystack secret key or the Brevo key here.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
# Must match the region the Cloud Functions are deployed to.
NUXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Push notifications through Cloud Messaging (Project settings > Cloud Messaging):
# the sender id, and the public key of a Web Push certificate. Both public.
# Leave either empty and the app offers no push (as in the emulators, which
# have no Cloud Messaging).
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# Where links in account emails lead back to, e.g. https://app.afriff.com.
# Leave empty to use wherever the app is served from.
NUXT_PUBLIC_APP_URL=

# Local Emulator Suite: run `bun run emulators` and `bun run emulators:seed`,
# then uncomment these. Nothing reaches a real project.
# NUXT_PUBLIC_API_MODE=firebase
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-afriff
# NUXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
