# Which API the console talks to:
#   mock      the demo console, with demo orders (sign in as ops@afriff.test / ops-demo-1)
#   firebase  Firebase Auth, Firestore and the ops Cloud Function
NUXT_PUBLIC_API_MODE=mock

# Simulated latency for mock calls, in milliseconds (0 = instant).
NUXT_PUBLIC_MOCK_LATENCY=200

# ---------------------------------------------------------------- firebase mode
# The same web config as the other apps (public by design). Rebuild after changing.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Local Emulator Suite (`bun run emulators`). Give yourself an admin account with
# `bun run staff -- --email you@afriff.test --role admin --password <choose one>`.
# NUXT_PUBLIC_API_MODE=firebase
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-afriff
# NUXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
