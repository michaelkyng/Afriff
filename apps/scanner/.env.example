# Which API the scanner talks to:
#   mock      the demo door, on placeholder data (sign in as door@afriff.test / door-demo-1)
#   firebase  Firebase Auth, Firestore and the checkIn Cloud Function
NUXT_PUBLIC_API_MODE=mock

# Simulated latency for mock calls, in milliseconds (0 = instant).
NUXT_PUBLIC_MOCK_LATENCY=250

# ---------------------------------------------------------------- firebase mode
# The same web config as the attendee app (public by design). A static build
# bakes these in when it is generated: rebuild after changing them.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Local Emulator Suite (`bun run emulators`). Give yourself a door account with
# `bun run staff -- --email door@afriff.test --role door`.
# NUXT_PUBLIC_API_MODE=firebase
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-afriff
# NUXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
