# Secrets for the local emulators only. Copy to .secret.local (git-ignored).
# Deployed projects read them from Secret Manager instead:
#   bun run firebase functions:secrets:set PAYSTACK_SECRET_KEY --project <id>

# A Paystack TEST secret key (sk_test_...) from Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# A Brevo API key (Settings > SMTP & API > API keys). Unused while MAIL_TRANSPORT=log.
BREVO_API_KEY=replace_me
