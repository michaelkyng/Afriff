# Parameters for the Cloud Functions (firebase-functions/params).
# Copy to .env for every project, or .env.<project-id> per project. These are
# not secrets: they are uploaded with the functions. Secrets go through
# `firebase functions:secrets:set` (see firebase/README.md).

# Public address of the attendee app, without a trailing slash. Paystack sends
# attendees back here and email links point here.
APP_URL=http://localhost:3000

# Sender for festival email. Must be a sender or domain verified in Brevo.
MAIL_FROM_EMAIL=tickets@example.com
MAIL_FROM_NAME=AFRIFF
# Optional reply-to address, e.g. the festival desk.
MAIL_REPLY_TO=

# "brevo" sends email; "log" writes it to the function logs instead, for the
# emulators and for staging without a Brevo account.
MAIL_TRANSPORT=brevo
