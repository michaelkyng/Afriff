    "./types": "./src/types.ts",
    "./format": "./src/format.ts",
    "./programme": "./src/programme.ts",
    "./plan": "./src/plan.ts",
    "./qr": "./src/qr.ts",
    "./tickets": "./src/tickets.ts",
    "./updates": "./src/updates.ts",
    "./filters": "./src/filters.ts",
    "./orders": "./src/orders.ts",
    "./door": "./src/door.ts",
    "./ops": "./src/ops.ts",
    "./push": "./src/push.ts",
    "./mock": "./src/mock/index.ts",
    "./mock/db": "./src/mock/db.ts",
    "./mock/door": "./src/mock/door.ts",
    "./mock/ops": "./src/mock/ops.ts",
    "./seed": "./src/mock/seed/index.ts",
    "./firebase": "./src/firebase/index.ts",
    "./firebase/door": "./src/firebase/door.ts",
    "./firebase/ops": "./src/firebase/ops.ts",
    "./firebase/schema": "./src/firebase/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
