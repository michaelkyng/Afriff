{
  "name": "afriff",
  "private": true,
  "type": "module",
  "description": "AFRIFF deployable apps, Cloud Functions, shared Nuxt layers and framework-independent packages.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "layers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:pwa",
    "dev:pwa": "bun run --filter @afriff/pwa dev",
    "build": "bun run --filter '*' build",
    "build:pwa": "bun run --filter @afriff/pwa build",
    "build:functions": "bun run --filter @afriff/functions build",
    "generate": "bun run --filter '*' generate",
    "generate:pwa": "bun run --filter @afriff/pwa generate",
    "preview:server": "bun run --filter @afriff/pwa preview",
    "preview:pwa": "bun run --filter @afriff/pwa preview:pwa",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages apps/pwa/tests apps/functions/tests",
    "test:rules": "firebase emulators:exec --only firestore --project demo-afriff \"node --test firebase/tests/*.test.js\"",
    "check": "bun run typecheck && bun run test",
    "firebase": "firebase",
    "emulators": "bun run build:functions && firebase emulators:start --project demo-afriff",
    "emulators:seed": "bun run --filter @afriff/functions seed",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "brand:assets": "bun run --filter @afriff/ui-kit brand:assets",
    "postinstall": "bun run --filter '*' postinstall"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.32.1"
  }
}
